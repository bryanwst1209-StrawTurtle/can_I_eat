<view class="container">
  <view class="card bg-info">
    <view class="level-info">配了家庭成员，结论才是给具体人看的</view>
    <view class="muted small">没配任何人时，只给通用的红绿灯判断。</view>
  </view>

  <view class="card bg-warn" wx:if="{{error}}">
    <view class="level-warn">{{error}}</view>
    <block wx:if="{{openid}}">
      <view class="muted small" style="margin-top:12rpx;">当前 openid：</view>
      <view class="small" style="word-break:break-all;">{{openid}}</view>
      <button class="btn-secondary" bindtap="copyOpenid">复制 openid</button>
      <view class="muted small">把它加进云数据库 families 集合某条记录的 memberOpenids 数组里即可。</view>
    </block>
  </view>

  <view class="card" wx:if="{{!editing}}">
    <view class="card-title">家庭成员</view>
    <view class="muted small" wx:if="{{!members.length && !loading && !error}}">还没添加任何人</view>
    <view class="row" wx:for="{{members}}" wx:key="_id" data-idx="{{index}}" bindtap="edit">
      <view>
        <view>{{item.name}}</view>
        <view class="muted small">{{item.concernLabels.length ? item.concernLabels : '无特别关注'}}</view>
      </view>
      <text class="muted">编辑 ›</text>
    </view>
    <button class="btn-primary" bindtap="add">添加成员</button>
  </view>

  <view class="card" wx:if="{{editing}}">
    <view class="card-title">{{editing._id ? '编辑成员' : '添加成员'}}</view>
    <view class="row">
      <text class="muted">称呼</text>
      <input value="{{editing.name}}" bindinput="onName" placeholder="如 爸爸"
             style="text-align:right;flex:1;margin-left:24rpx;"/>
    </view>
    <view style="margin-top:20rpx;">
      <view class="muted small">需要注意什么（可多选）</view>
      <view style="display:flex;flex-wrap:wrap;margin-top:12rpx;">
        <view wx:for="{{concerns}}" wx:key="key"
              data-key="{{item.key}}" bindtap="toggleConcern"
              class="{{selected[item.key] ? 'bg-info level-info' : ''}}"
              style="padding:12rpx 24rpx;margin:0 16rpx 16rpx 0;border:2rpx solid #dfe5e1;border-radius:32rpx;font-size:26rpx;">
          {{item.label}}
        </view>
      </view>
    </view>
    <button class="btn-primary" bindtap="save">保存</button>
    <button class="btn-secondary" bindtap="cancel">取消</button>
    <button class="btn-secondary" wx:if="{{editing._id}}" bindtap="remove" style="color:#c53030;border-color:#c53030;">删除</button>
  </view>
</view>
