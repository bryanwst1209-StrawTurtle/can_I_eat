<view class="container">
  <view class="card bg-warn" wx:if="{{error}}"><text class="level-warn">{{error}}</text></view>

  <view class="card">
    <view class="card-title">扫过的东西</view>
    <view class="muted small" wx:if="{{!records.length && !loading && !error}}">还没有记录</view>
    <view class="row" wx:for="{{records}}" wx:key="_id" data-id="{{item._id}}" bindtap="open">
      <view style="flex:1;">
        <view>{{item.productName || '未命名商品'}}</view>
        <view class="muted small">{{item.timeText}}</view>
      </view>
      <text class="level-{{item.judgement.overallLevel}} small">{{item.judgement.overallText}}</text>
    </view>
  </view>
</view>
